# ═══════════════════════════════════════════════════════════════════════════
#  Polymarket Betting Bot — environment template
#
#  Setup:
#    1. Copy this file:   cp .env.example .env
#    2. Fill in values below (leave blanks you do not need).
#    3. Never commit `.env` — it is listed in `.gitignore`.
#
#  Phase A (observation): CLOB credentials are optional for public reads;
#  do NOT set PRIVATE_KEY. Run with `dry_run: true` in config.yaml.
#
#  See README.md for quickstart and PLAN.md for architecture.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Logging ───────────────────────────────────────────────────────────────

# Console log verbosity. Default: INFO (daemon cycle summaries, warnings).
# Use DEBUG for per-signal paper_consumer lines and API trace detail.
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ─── Polymarket CLOB API (optional in Phase A) ─────────────────────────────

# API credentials for authenticated CLOB access. Phase A uses read-only
# public endpoints (data-api, leaderboard) without these; keys may help
# rate limits or future authenticated reads. Generate at Polymarket docs → CLOB API.
# Registered at startup for log redaction if set.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=


# ─── Optional enrichment ─────────────────────────────────────────────────────

# Polygonscan API key for on-chain USDC / wallet enrichment (Phase B).
# Optional enrichment — bot runs without it; one startup warning if absent.
# POLYGONSCAN_API_KEY=


# ─── Phase B only — wallet signing ─────────────────────────────────────────

# Polygon wallet private key (hex, with or without 0x prefix).
# Phase B only — do not uncomment until calibration gate passes AND
# decision-matrix verdict is BUILD_B_RELAXED or BUILD_B_FULL (see PLAN.md §11, §8).
#
# In Phase A, leave this commented out. main.py registers it for log redaction
# only if present; the signing key must not enter memory during observation.
#
# PRIVATE_KEY=


# ─── Development / testing only ────────────────────────────────────────────

# Set to 0 to skip live-network tests in tests/smoke_module7.py (test 12).
# Not used by main.py serve/scan/status.
# LIVE_API_TESTS=1
